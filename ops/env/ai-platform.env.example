# Do not put real values in the repository.
# Generate /etc/ai-platform/ai-platform.env interactively on the server with:
# python3 scripts/configure_security.py --username <admin-user> --output /etc/ai-platform/ai-platform.env
#
# The generated file contains these keys and must remain mode 0600:
# AI_PLATFORM_SECRET_KEY=
# AI_PLATFORM_ADMIN_USERNAME=
# AI_PLATFORM_ADMIN_PASSWORD_HASH=
# AI_PLATFORM_MEDIA_ROOT=/opt/ai-platform/data/media
# AI_PLATFORM_PUBLIC_BASE_URL=https://ai-platform.example
